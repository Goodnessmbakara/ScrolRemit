# Scroll Sepolia Network
VITE_SCROLL_RPC_URL=https://sepolia-rpc.scroll.io/
VITE_CHAIN_ID=534351

# Privy Authentication (Required)
# Get from https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# Pinata IPFS (Optional for development - uses mock if not set)
# Get from https://pinata.cloud
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=

# Smart Contracts (Will be set after deployment)
VITE_PROFILE_REGISTRY_ADDRESS=
VITE_STREAMING_CONTRACT_ADDRESS=
VITE_MOCK_USDC_ADDRESS=

# Biconomy Account Abstraction (Optional - for gasless transactions)
# Get from https://dashboard.biconomy.io
VITE_BICONOMY_BUNDLER_URL=
VITE_BICONOMY_PAYMASTER_API_KEY=